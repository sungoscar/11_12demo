DB_HOST=localhost
DB_PORT=5432
DB_NAME=submission_review
DB_USER=postgres
DB_PASSWORD=請填入本機密碼
DB_SSLMODE=prefer

# 執行 README 的金鑰產生步驟；不可使用範例文字作為正式金鑰。
SESSION_SECRET=請填入至少32字元的隨機金鑰
APP_ENV=development
SESSION_HTTPS_ONLY=false

# seed_users.py 預設使用不回顯的互動輸入。
# 自動化時可透過 SEED_AUTHOR_PASSWORD、SEED_EDITOR_PASSWORD 環境變數提供密碼。
